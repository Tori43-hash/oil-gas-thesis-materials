 CLS
 PRINT "Введите следующие исходные данные"
 INPUT "Начальные запасы Qн,млрд.м^3", Qn: Qn = 300
 INPUT "Начальное пластовое давление Рн,Мпа", Pn: Pn = 30
 INPUT "Пластовая температура Тпл, К", Tpl: Tpl = 336
 PRINT "Коэффициенты фильтрационных сопротивлений"
 INPUT " А,МПа^2/(тыс.м^3/сут.)", A: A = .02
 INPUT " В,(МПа/тыс.м^3/сут.)^2", B: B = .0005
 INPUT "Допустимая депрессия dP,МПа", dP: dP = 3
 Nm = Qn / 24.04
 FOR i = 1 TO 5
 READ Q(i)
 NEXT i
 Q = 0: P = Pn
 R = 8.31: Tct = 293: Pat = .1
 Zn = .000482 * P ^ 2 - .01685 * P + 1.01
 FOR i = 1 TO 5
 Q = Q + Q(i)
1 : Z = .000482 * P ^ 2 - .01685 * P + 1.01
 ao = Z * R * Tpl / (P * Nm)
 P1 = (Pn / Zn - Pat * Tpl * Q / (ao * Tct)) * Z
 IF ABC(P1 - P) > .05 THEN GOTO 2 ELSE GOTO 3
2 : P = P1: GOTO 1
3 : P(i) = P1
 qc(i) = -A / (2 * B) + ((A / 2 * B) ^ 2 + (2 * P(i) - dP) * dP / B) ^ .5
 N(i) = Q(i) / (.33 * qc(i))
 NEXT i
 FOR i = 1 TO 5
 qc(i) = -A / (2 * B) + ((A / 2 * B) ^ 2 + (2 * P(i) - dP) * dP / B) ^ .5
 N(i) = 1000 * Q(i) / (.33 * qc(i))
 NEXT i
 PRINT "--------------------------------------------------------------"
 PRINT "| ГОД |Q(t),млрд.м^3/сут.| Р(t),МПа | q(t),млн.м^3/сут.|  N  |"
 PRINT "--------------------------------------------------------------"
 FOR i = 1 TO 5
 PRINT USING "|  #  |        ##        | ##.####  |     ###.####     | ### |"; i; Q(i); P(i); qc(i); N(i)
 NEXT i
 PRINT "--------------------------------------------------------------"
 DATA 5,10,15,15,15

