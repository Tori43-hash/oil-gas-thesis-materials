\par }\pard \s20\nowidctlpar\widctlpar\tqc\tx4153\tqr\tx8306\adjustright {\fs24\lang1024 {\shpgrp{\*\shpinst\shpleft-46\shptop71\shpright9075\shpbottom129\shpfhdr1\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt0\shpz1\shplid2052{\sp{\sn groupLeft}{\sv 0}}{\sp{\sn groupTop}{\sv -10}}{\sp{\sn groupRight}{\sv 20000}}{\sp{\sn groupBottom}{\sv 20000}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn lidRegroup}{\sv 0}}{\shp{\*\shpinst\shplid2053{\sp{\sn relLeft}{\sv 0}}{\sp{\sn relTop}{\sv 19655}}{\sp{\sn relRight}{\sv 20000}}{\sp{\sn relBottom}{\sv 20000}}{\sp{\sn fRelFlipH}{\sv 0}}{\sp{\sn fRelFlipV}{\sv 0}}{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6350}}{\sp{\sn lineStartArrowWidth}{\sv 2}}{\sp{\sn lineStartArrowLength}{\sv 2}}{\sp{\sn lineEndArrowWidth}{\sv 2}}{\sp{\sn lineEndArrowLength}{\sv 2}}{\sp{\sn fShadow}{\sv 0}}}}{\shp{\*\shpinst\shplid2054{\sp{\sn relLeft}{\sv 0}}{\sp{\sn relTop}{\sv -10}}{\sp{\sn relRight}{\sv 20000}}{\sp{\sn relBottom}{\sv 335}}{\sp{\sn fRelFlipH}{\sv 0}}{\sp{\sn fRelFlipV}{\sv 0}}{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6350}}{\sp{\sn lineStartArrowWidth}{\sv 2}}{\sp{\sn lineStartArrowLength}{\sv 2}}{\sp{\sn lineEndArrowWidth}{\sv 2}}{\sp{\sn lineEndArrowLength}{\sv 2}}{\sp{\sn fShadow}{\sv 0}}}}}{\shprslt{\*\do\dobxcolumn\dobypara\dodhgt8193\dppolygon\dppolycount4\dpptx0\dppty0\dpptx9121\dppty0\dpptx9121\dppty58\dpptx0\dppty58\dpx-46\dpy71\dpxsize9121\dpysize58\dpfillfgcr255\dpfillfgcg255\dpfillfgcb255\dpfillbgcr255\dpfillbgcg255\dpfillbgcb255\dpfillpat1\dplinew15\dplinecor0\dplinecog0\dplinecob0}}}}{
\par 
\par }}\pard\plain \qj\fi709\sl360\slmult1\nowidctlpar\widctlpar\adjustright \fs20\lang1049 {\scaps\f18\fs28 1.2. Анализ текущего состояния разработки Юбилейного 
\par }\pard\plain \s16\qj\fi709\sl360\slmult1\nowidctlpar\widctlpar\adjustright \fs28\lang1049 {\scaps\f18     месторождения.
\par }\pard\plain \qj\fi709\sl360\slmult1\nowidctlpar\widctlpar\adjustright \fs20\lang1049 {\f18\fs28 Юбилейное газовое месторождение расположено на севере Тюме}{\f18\fs28 н}{\f18\fs28 ской области в Ямало-Ненецком автономном округе. Месторождение вв}{\f18\fs28 е}{\f18\fs28 дено в разработку в декабре 1992 года. Запасы газа сеноманской залежи утверждены ГКЗ СССР в 1972 году в объеме  220,618 млрд. м}{\fs28\super 3}{\f18\fs28 . В результ}{\f18\fs28 а}{\f18\fs28 те дополнительного бурения, уточнения геологического строения в 1992 году запасы сеноманской залежи Юбилейного месторождения пересчит}{\f18\fs28 а}{\f18\fs28 ны и оценены в объеме  475,976 млрд. м}{\fs28\super 3}{\f18\fs28 . В 1995 году ТюменНИИГипрог}{\f18\fs28 а}{\f18\fs28 зом проведен пересчет запасов, в соответствии с которым запасы состав}{\f18\fs28 и}{\f18\fs28 ли 375,872 млрд. м}{\fs28\super 3}{\f18\fs28   (протокол ГКЗ от 16.03.95 г.).
\par Проект разработки сеноманской залежи выполнен ТюменНИИГ}{\f18\fs28 и}{\f18\fs28 прогазом в 1985 году. По уточненным  запасам ( 375,872 млрд. м}{\fs28\super 3}{\f18\fs28 ) проект разработки с годовым отбором в 17 млрд. м}{\fs28\super 3 }{\f18\fs28  выполнен в 1996 году. На з}{\f18\fs28 а}{\f18\fs28 седании секции по разработке Комиссии по месторождениям и ПХГ пр}{\f18\fs28 и}{\f18\fs28 нят представленный \ldblquote Проект разработки сеноманской газовой залежи Юбилейного месторождения\rdblquote  на годовой отбор 17 млрд. м}{\fs28\super 3}{\f18\fs28 , обеспеч}{\f18\fs28 и}{\f18\fs28 вающий его доведение до 20 млрд.м}{\fs28\super 3}{\f18\fs28  без резкого колебания в отборах из-за сезонной неравн}{\f18\fs28 о}{\f18\fs28 мерности (протокол №20-р/97 от 20.03.97 г).}{\fs28\super  }{\fs28  
\par }{\f18\fs28 По состоянию на 01.01.99 года из залежи отобрано 61339,301 млрд. м}{\fs28\super 3}{\f18\fs28  , что составляет 27,804% от первоначально утвержденных запасов или 16,32 % от пересчитанных. Годовая добыча составила 6528,432 млрд. м}{\fs28\super 3}{\f18\fs28  газа, что ниже проекта на 8471,568 млрд. м}{\fs28\super 3}{\f18\fs28\lang1033  (табл}{\fs24 .7)}{\f18\fs28 , это связано с огран}{\f18\fs28 и}{\f18\fs28 ченным отбором газа }{\fs28\lang1033  }{\f18\fs28 в летнее время, т. к. на Юбилейном месторождении не закончено строительство УКПГ. 
\par }{\fs28 
\par 
\par 
\par }\pard\plain \s18\qj\fi709\sl360\slmult1\nowidctlpar\widctlpar\adjustright \fs28\lang1049\cgrid {\cgrid0 
