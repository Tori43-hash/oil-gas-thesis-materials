\par }\trowd \trgaph108\trleft-108 \clvertalt\clbrdrt\brdrs\brdrw10 \cltxlrtb \cellx709\clvertalt\clbrdrt\brdrs\brdrw10 \clbrdrl\brdrs\brdrw10 \clbrdrr\brdrs\brdrw10 \cltxlrtb \cellx2641\clvertalt\clbrdrt\brdrs\brdrw10 \cltxlrtb \cellx9072\pard\plain \qj\nowidctlpar\widctlpar\intbl\tx993\adjustright \fs20\lang1049 {\f18\fs28 Год}{\fs28\lang1033 \cell }\pard \qc\nowidctlpar\widctlpar\intbl\tx993\adjustright {\f18\fs28 Кол-во иссл}{\f18\fs28 е}{\f18\fs28 дований }{\fs28\lang1033 \cell }{\f18\fs28 Средневзвешенные     фильтрационные                   коэффициенты}{\fs28\lang1033 \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs28\lang1033 \row }\trowd \trgaph108\trleft-108 \clvertalt\clbrdrb\brdrs\brdrw10 \cltxlrtb \cellx709\clvertalt\clbrdrl\brdrs\brdrw10 \clbrdrb\brdrs\brdrw10 \clbrdrr\brdrs\brdrw10 \cltxlrtb \cellx2641\clvertalt\clbrdrt\brdrs\brdrw10 \clbrdrb\brdrs\brdrw10 \clbrdrr\brdrs\brdrw10 \cltxlrtb \cellx5769\clvertalt\clbrdrt\brdrs\brdrw10 \clbrdrb\brdrs\brdrw10 \cltxlrtb \cellx9072\pard \qc\sl360\slmult1\nowidctlpar\widctlpar\intbl\tx993\adjustright {\fs28\lang1033 \cell \cell a}{\fs28\lang1033 {\field{\*\fldinst SYMBOL 215 \\f "Symbol" \\s 14}{\fldrslt\f3\fs28}}}{\fs28\lang1033 10}{\fs28\lang1033\super -2}{\fs28\lang1033 \cell B}{\fs28\lang1033 {\field{\*\fldinst SYMBOL 215 \\f "Symbol" \\s 14}{\fldrslt\f3\fs28}}}{\fs28\lang1033 10}{\fs28\lang1033\super -2}{\fs28\lang1033 \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs28\lang1033 \row }\trowd \trgaph108\trleft-108 \clvertalt\cltxlrtb \cellx709\clvertalt\clbrdrl\brdrs\brdrw10 \clbrdrr\brdrs\brdrw10 \cltxlrtb \cellx2641\clvertalt\clbrdrr\brdrs\brdrw10 \cltxlrtb \cellx5769\clvertalt\cltxlrtb \cellx9072\pard \qc\sl360\slmult1\nowidctlpar\widctlpar\intbl\tx993\adjustright {\fs28 1993}{\fs28\lang1033 \cell }{\fs28 1}{\fs28\lang1033 \cell }{\fs28 0,129}{\fs28\lang1033 \cell }{\fs28 0,000061}{\fs28\lang1033 \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs28\lang1033 \row }\pard \qc\sl360\slmult1\nowidctlpar\widctlpar\intbl\tx993\adjustright {\fs28 1994}{\fs28\lang1033 \cell }{\fs28 9}{\fs28\lang1033 \cell }{\fs28 0,118}{\fs28\lang1033 \cell }{\fs28 0,000238}{\fs28\lang1033 \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs28\lang1033 \row }\pard \qc\sl360\slmult1\nowidctlpar\widctlpar\intbl\tx993\adjustright {\fs28 1995\cell 6\cell 0,279\cell 0,000358\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs28\lang1033 \row }\pard \qc\sl360\slmult1\nowidctlpar\widctlpar\intbl\tx993\adjustright {\fs28 1996\cell 10\cell 0,295\cell 0,000073\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs28\lang1033 \row }\pard \qc\sl360\slmult1\nowidctlpar\widctlpar\intbl\tx993\adjustright {\fs28 1997\cell 10\cell 0,315\cell 0,000130\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs28\lang1033 \row }\trowd \trgaph108\trleft-108 \clvertalt\cltxlrtb \cellx709\clvertalt\clbrdrl\brdrs\brdrw10 \clbrdrr\brdrs\brdrw10 \cltxlrtb \cellx2641\clvertalt\clbrdrr\brdrs\brdrw10 \cltxlrtb \cellx5769\clvertalt\cltxlrtb \cellx9072\pard \qc\sl360\slmult1\nowidctlpar\widctlpar\intbl\tx993\adjustright {\fs28 1998\cell 6\cell 0,371\cell 0,000520\cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\fs28 \row }\pard\plain \s16\qj\fi709\sl360\slmult1\nowidctlpar\widctlpar\tx993\adjustright \fs28\lang1049 {
\par }{\f18 Эксплуатационные скважины оборудованы насосно-компрессорными трубами  (НКТ)  диаметром 168 мм, применение НКТ увеличенного диаметра обуславливает невысокие потери пластовой эне}{\f18 р}{\f18 гии от пласта до устья. 
\par }\pard\plain \qj\fi709\sl360\slmult1\nowidctlpar\widctlpar\tx993\adjustright \fs20\lang1049 {\f18\fs28 Высокими остаются продуктивные характеристики скважин; факт}{\f18\fs28 и}{\f18\fs28 ческая депрессия на пласт не превышает расчетных значений и составила в течение года 0,19 МПа.  В целом внутри эксплуатационного поля пласт}{\f18\fs28 о}{\f18\fs28 вое давление снижается достаточно равномерно, (рис. }{\fs28\lang1033 14}{\f18\fs28 ). Имеющиеся различия в большей степени обусловлены временем ввода скважин в эк}{\f18\fs28 с}{\f18\fs28 плуатацию. Текущее положение ГВК не измен}{\f18\fs28 и}{\f18\fs28 лось с начала разработки}{\b\fs28 . 
\par }{\f18\fs28 Анализируя текущее состояние разработки Юбилейного месторо}{\f18\fs28 ж}{\f18\fs28 дения и проектные значения основных технологических показателей, сл}{\f18\fs28 е}{\f18\fs28 дует отметить, что эксплуатация месторождения ведётся согласно }{\fs28\lang1033 “}{\f18\fs28 Проекту разработки сеноманской залежи Юбилейного месторождения}{\fs28\lang1033 ”}{\f18\fs28 .  Технологические показатели разработки его представлены в таблице 8. Накопленная добыча газа и годовой отбор ниже проектной величины из-за остановок промысла в летнее время.   
\par }{\fs28 \page \page }{\scaps\f18\fs28 1.3. Анализ текущего состояния разработки Ямсовейского 
\par }\pard \qc\fi709\sl360\slmult1\nowidctlpar\widctlpar\adjustright {\scaps\f18\fs28 м}{\scaps\f18\fs28 е}{\scaps\f18\fs28 сторождения
\par }\pard \fi709\sl360\slmult1\nowidctlpar\widctlpar\adjustright {\f18\fs28 Ямсовейское газовое месторождение расположено в 80 км к сев}{\f18\fs28 е}{\f18\fs28 ро-западу от пос. Тарко-Сале. Месторождение открыто в 1970 году. Газоно}{\f18\fs28 с}{\f18\fs28 ными являются сеноманские отложения, залегающие на глубине 885-1040 м.  Запасы газа по сеноманской газовой залежи, утверждённые ГКЗ в 1972 году, составляют 428,583 млрд.м}{\fs28\super 3}{\f18\fs28  (Протокол ГКЗ № 6713). Институтом ТюменНИИГипрогаз по данным эксплуатационного бурения в 1997 году проведён пересчёт начальных запасов газа объёмным методом, которые составили по Ямсовейской площади по категории В+С}{\fs28\sub 1}{\f18\fs28 - 530,19 млрд. м}{\fs28\super 3}{\f18\fs28 , по Ярейской (Южно-Ямсовейской) по С}{\fs28\sub 1}{\f18\fs28 -22,2млрд.м}{\fs28\super 3}{\f18\fs28  и С}{\fs28\sub 2}{\f18\fs28 -8,02 млрд.м}{\fs28\super 3}{\f18\fs28 , т.е. запасы увел}{\f18\fs28 и}{\f18\fs28 чились на 23,5}{\fs28\lang1033 %}{\fs28 .
\par }{\f18\fs28 Проект разработки сеноманской газовой залежи выполнен Тюме}{\f18\fs28 н}{\f18\fs28 НИИГипрогазом (протокол № 3/90 от14.02.90 г.) и составлен на объём г}{\f18\fs28 о}{\f18\fs28 довой добычи 20 млрд.м}{\fs28\super 3}{\f18\fs28 . Ямсовейское газовое месторождение введено в промышленную разработку 30 августа 1997 г}{\f18\fs28 о}{\f18\fs28 да.
\par }\pard \qj\fi709\sl360\slmult1\nowidctlpar\widctlpar\adjustright {\f18\fs28 По состоянию на 01.01.1999 г. (месторождение находится в эксплу}{\f18\fs28 а}{\f18\fs28 тации 1 год и 4 месяца) из залежи отобрано 20,98233 млрд.м}{\fs28\super 3}{\f18\fs28  газа, что с}{\f18\fs28 о}{\f18\fs28 ставляет 4,90% от начальных запасов, утверждённых ГКЗ (428,6 млрд.м}{\fs28\super 3}{\f18\fs28 ). За отчётный период годовая добыча составила 16,673799 млрд. м}{\fs28\super 3}{\f18\fs28  газа, что ниже проекта на 1,326.млрд. м}{\fs28\super 3 }{\f18\fs28 , это связано с отст}{\f18\fs28 а}{\f18\fs28 ванием ввода скважин. 
\par Текущее пластовое давление на конец года составило 9,18 МПа, за год пластовое давление снизилось на 0,24 МПа. В целом пластовое давл}{\f18\fs28 е}{\f18\fs28 ние по всему месторождению снижается равномерно (рис. }{\fs28\lang1033 15}{\f18\fs28 ). Замеры пластовых давлений по наблюдательным скважинам №№ 15, 51, 53 и 57, соответственно имеют следующие величины 9,27 МПа, 9,60 МПа, 9,30 МПа и 9,27 МПа, что на 0,09-0,42 МПа выше, чем в эксплуатационном п}{\f18\fs28 о}{\f18\fs28 ле, что говорит о равномерной отработке запасов газа по площади газоно}{\f18\fs28 с}{\f18\fs28 ности. Пластовое давление по скважинам, вскрывшим различные части разреза, отличаются на 0,10-0,04 МПа (куст скв.141-145,311-313, 131-135, 161-164),что говорит о равномерном снижении пластового давления по разрезу продуктивных отложений. Устьевое давление на 01.01.99 год ра}{\f18\fs28 в}{\f18\fs28 няется 8,15 МПа и обеспечивает бескомпрессорную добычу газа.
\par Общий фонд скважин составляет 125 единиц, из них эксплуатацио}{\f18\fs28 н}{\f18\fs28 ных - 82, в том числе действующих - 82, во временной консервации 22 скважины. Количество действующих скважин соответствует количеству проектных скважин за текущий год.
\par Эксплуатационные скважины Ямсовейского месторождения имеют высокую продуктивную характеристику, поскольку газонасыщенные ко}{\f18\fs28 л}{\f18\fs28 лектора характеризуются высокими добывными возможностями и филь}{\f18\fs28 т}{\f18\fs28 рационно-емкостными свойствами. По гистограмме распределения деб}{\f18\fs28 и}{\f18\fs28 тов по скважинам }{\fs28\lang1033 (}{\f24\fs24 рис.16}{\f1\fs28 ) }{\f18\fs28 видно, что 24% действующего фонда работает с дебитами 1млн.м}{\fs28\super 3}{\f18\fs28 /сут. и выше. Средний дебит одной скважины на конец 1998 года составил 840 тыс. м}{\fs28\super 3}{\f18\fs28 , при депрессии на пласт 0,15 МПа. Средн}{\f18\fs28 е}{\f18\fs28 суточная добыча - 67692 тыс.м}{\fs28\super 3}{\fs28 . }{\f18\fs28  Добыча газа на месторождении осущес}{\f18\fs28 т}{\f18\fs28 вляется за счет естественной пластовой энергии, режим работы залежи с}{\f18\fs28 о}{\f18\fs28 ответств}{\f18\fs28 у}{\f18\fs28 ет газовому.
\par }\pard\plain \s16\qj\fi709\sl360\slmult1\nowidctlpar\widctlpar\adjustright \fs28\lang1049 {\f18 На Ямсовейском месторождении с целью контроля за разработкой проводятся геофизические, геолого-промысловые и гидрохимические и}{\f18 с}{\f18 следования. Контроль за количеством механических примесей и воды в}{\f18 ы}{\f18 полнен коллектором Надым-1 в 77 скважинах, вынос механических прим}{\f18 е}{\f18 сей отсутствует, вынос воды по результатам исследований в пределах но}{\f18 р}{\f18 мы.
\par }\pard\plain \qj\fi709\sl360\slmult1\nowidctlpar\widctlpar\adjustright \fs20\lang1049 {\f18\fs28 Гидрохимический контроль за разработкой месторождения осущес}{\f18\fs28 т}{\f18\fs28 влялся на основе химического анализа проб жидкости, отобранных на устье действующих скважин, выносимых с продукцией скважин. За 1998 год с месторождения отобрано 152 пробы воды. По химанализам проб о}{\f18\fs28 п}{\f18\fs28 ределён по двум вариантам тип выносимой воды.  Анализ результатов по этим вариантам показывает вынос конденсац}{\f18\fs28 и}{\f18\fs28 онной  воды. }{\i\fs28 
\par }\pard \qj\fi709\sl360\slmult1\nowidctlpar\widctlpar\tx993\adjustright {\f18\fs28 На стационарных режимах фильтрации ДИКТом в 1998 году пров}{\f18\fs28 е}{\f18\fs28 дено 37 скважино-исследований. По результатам газодинамических иссл}{\f18\fs28 е}{\f18\fs28 дований скважин получено 65 пар фильтрационных коэффициентов а и  }{\fs28\lang1033 b}{\f18\fs28 ,  средневзвешенные значения за год по месторожд}{\f18\fs28 е}{\f18\fs28 нию таковы}{\fs28\lang1033 :}{\fs28  }{\fs28\lang1033 
\par }\pard \qj\sl360\slmult1\nowidctlpar\widctlpar\tx993\adjustright {\f18\fs28\lang1033 а=0,266}{\fs28\lang1033 {\field{\*\fldinst SYMBOL 215 \\f "Symbol" \\s 14}{\fldrslt\f3\fs28}}}{\fs28\lang1033 10}{\fs28\lang1033\super -2}{\f18\fs28\lang1033 МПа}{\fs28\lang1033\super 2}{\f18\fs28\lang1033 сут/тыс.м}{\fs28\lang1033\super 3}{\fs28\lang1033    b}{\fs28 =0,000211}{\fs28\lang1033 {\field{\*\fldinst SYMBOL 215 \\f "Symbol" \\s 14}{\fldrslt\f3\fs28}}}{\fs28 10}{\fs28\super -2}{\f18\fs28 (МПа сут/тыс.м}{\fs28\super 3}{\fs28 )}{\fs28\super 2 
\par }\pard\plain \s16\qj\fi709\sl360\slmult1\nowidctlpar\widctlpar\tx993\adjustright \fs28\lang1049 {\f18 В расчете }{\lang1033 c}{\f18 редневзвешенных значений фильтрационных коэффиц}{\f18 и}{\f18 ентов рассматриваются только те исследования, где 0}{\lang1033 <a<1 }{\f18 и }{\lang1033 b>0}{.}{\lang1033 
\par }\pard\plain \qc\fi709\sl360\slmult1\nowidctlpar\widctlpar\tx993\adjustright \fs20\lang1049 {\f18\fs28                                                                                                    Табл. 9
