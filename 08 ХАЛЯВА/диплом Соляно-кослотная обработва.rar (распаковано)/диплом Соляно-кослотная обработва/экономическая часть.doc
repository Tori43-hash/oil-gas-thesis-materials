{\rtf1\ansi {\colortbl;\red0\green0\blue0;\red0\green0\blue255;\red0\green255\blue255;\red0\green255\blue0;\red255\green0\blue255;\red255\green0\blue0;\red255\green255\blue0;\red255\green255\blue255;}{\fonttbl{\f0\froman\cpg0\fcharset0 Times New Roman;}{\f1\froman\cpg1252\fcharset0 Times New Roman;}{\f2\froman\cpg1251\fcharset204 Times New Roman;}{\f3\froman\cpg1250\fcharset238 Times New Roman;}{\f4\froman\cpg1257\fcharset186 Times New Roman;}{\f5\froman\cpg1254\fcharset162 Times New Roman;}{\f6\froman\cpg1253\fcharset161 Times New Roman;}{\f7\froman\cpg1255\fcharset177 Times New Roman;}}\paperw11909\paperh16834 \sectd \sbknone \pard \plain {\f2\lang1049\fs20 4. \hich\af0\loch\af0\dbch\f2 \'dd\'ea\'ee\'ed\'ee\'ec\'e8\'f7\'e5\'f1\'ea\'e0\'ff\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f7\'e0\'f1\'f2\'fc}\par \pard \plain {\f2\lang1049\fs20 4.1 \hich\af0\loch\af0\dbch\f2 \'d2\'e5\'f5\'ed\'e8\'ea\'ee\hich\af0\dbch\af2\loch\f0 -\hich\af0\loch\af0\dbch\f2 \'fd\'ea\'ee\'ed\'ee\'ec\'e8\'f7\'e5\'f1\'ea\'e0\'ff\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f5\'e0\'f0\'e0\'ea\'f2\'e5\'f0\'e8\'f1\'f2\'e8\'ea\'e0\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'cd\'c3\'c4\'d3 \'ab\'d2\'f3\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'e8\'ec\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'e0\'e7\'e0\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ed\'e5\'f4\'f2\'fc\'bb}\par \pard \plain {\loch\af0\hich\af0\dbch\f2\lang1049\fs20 \'d2\'f3\'e9\'ec\'e0\'e7\'e8\'ed\'f1\'ea\'ee\'e5\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ec\'e5\'f1\'f2\'ee\'f0\'ee\'e6\'e4\'e5\'ed\'e8\'e5\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ed\'e0\'f5\'ee\'e4\'e8\'f2\'f1\'ff\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ed\'e0\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'e7\'e0\'ea\'eb\'fe\'f7\'e8\'f2\'e5\'eb\'fc\'ed\'ee\'e9 \'f1\'f2\'e0\'e4\'e8\'e8\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f0\'e0\'e7\'f0\'e0\'e1\'ee\'f2\'ea\'e8\hich\af0\dbch\af2\loch\f0 , \hich\af0\loch\af0\dbch\f2 \'ee\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f7\'e5\'ec\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f1\'e2\'e8\'e4\'e5\'f2\'e5\'eb\'fc\'f1\'f2\'e2\'f3\'e5\'f2\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f1\'f2\'e0\'e1\'e8\'eb\'e8\'e7\'e8\'f0\'f3\'fe\'f9\'e0\'ff\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ed\'e0\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f1\'f0\'e0\'e2\'ed\'e8\'f2\'e5\'eb\'fc\'ed\'ee \'ed\'e5\'e1\'ee\'eb\'fc\'f8\'ee\'ec\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'e7\'ed\'e0\'f7\'e5\'ed\'e8\'e8\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'e3\'ee\'e4\'ee\'e2\'e0\'ff\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'e4\'ee\'e1\'fb\'f7\'e0\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ed\'e5\'f4\'f2\'e8\hich\af0\dbch\af2\loch\f0 .}\par \pard \plain {\loch\af0\hich\af0\dbch\f2\lang1049\fs20 \'cf\'f0\'e8\'f7\'e5\'ec\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f1\'f2\'e0\'e1\'e8\'eb\'e8\'e7\'e0\'f6\'e8\'ff\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f3\'f0\'ee\'e2\'ed\'ff\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'e4\'ee\'e1\'fb\'f7\'e8\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ee\'f1\'f3\'f9\'e5\'f1\'f2\'e2\'eb\'ff\'e5\'f2\'f1\'ff\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'e7\'e0\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f1\'f7\'e5\'f2 \'ef\'f0\'ee\'e2\'e5\'e4\'e5\'ed\'e8\'e5\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ce\'cf\'c7\hich\af0\dbch\af2\loch\f0 , \hich\af0\loch\af0\dbch\f2 \'e2\'e2\'ee\'e4\'e0\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'e2\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'fd\'ea\'f1\'ef\'eb\'f3\'e0\'f2\'e0\'f6\'e8\'fe\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ed\'ee\'e2\'fb\'f5\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f1\'ea\'e2\'e0\'e6\'e8\'ed\hich\af0\dbch\af2\loch\f0 , \hich\af0\loch\af0\dbch\f2 \'ea\'e0\'ea\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'e4\'ee\'e1\'fb\'e2\'e0\'fe\'f9\'e8\'f5\hich\af0\dbch\af2\loch\f0 , \hich\af0\loch\af0\dbch\f2 \'f2\'e0\'ea\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'e8\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ed\'e0\'e3\'ed\'e5\'f2\'e0\'f2\'e5\'eb\'fc\'ed\'fb\'f5\hich\af0\dbch\af2\loch\f0 , \hich\af0\loch\af0\dbch\f2 \'f0\'e0\'e7\'eb\'e8\'f7\'ed\'fb\'f5\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ec\'e5\'f2\'ee\'e4\'ee\'e2\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ef\'ee\'e2\'fb\'f8\'e5\'ed\'e8\'ff\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ed\'e5\'f4\'f2\'e5\'ee\'f2\'e4\'e0\'f7\'e8\hich\af0\dbch\af2\loch\f0 .}\par \pard \plain {\loch\af0\hich\af0\dbch\f2\lang1049\fs20 \'c2\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f3\'f1\'eb\'ee\'e2\'e8\'ff\'f5\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f0\'fb\'ed\'ee\'f7\'ed\'ee\'e9\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'fd\'ea\'ee\'ed\'ee\'ec\'e8\'ea\'e8\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ee\'f1\'ee\'e1\'f3\'fe\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f0\'ee\'eb\'fc\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ef\'f0\'e8\'ee\'e1\'f0\'e5\'f2\'e0\'e5\'f2 \'e2\'ee\'e7\'e4\'e5\'e9\'f1\'f2\'e2\'e8\'e5\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ed\'e0\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ef\'f0\'e8\'e7\'e0\'e1\'ee\'e9\'ed\'f3\'fe\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'e7\'ee\'ed\'f3\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ef\'eb\'e0\'f1\'f2\'e0\hich\af0\dbch\af2\loch\f0 . \hich\af0\loch\af0\dbch\f2 \'c2\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'f0\'e5\'e7\'f3\'eb\'fc\'f2\'e0\'f2\'e5\hich\af0\dbch\af2\loch\f0  \hich\af0\loch\af0\dbch\f2 \'ee\'e1\'f0\'e0\'e