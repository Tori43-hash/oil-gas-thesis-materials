
  cls
  rem Программа расчета коэффициента продуктивности скважины
  def fnr(p)=exp(6.72-0.011*p)
  print "Ввести исходные данные."
  print "Пластовое давление, МПа  P1=";
  input P1
  input "Плотность пластовой нефти, кг/м^3 R0=";r0
  input "Плотность дегазированной нефти, кг/м^3 R=";r
  input "Плотность пластовой воды, кг/м^3 R4=";r4
  input "Затрубное давление газа, МПа P3=";p3
  input "Обводненность продукции скважины, доли ед. B=";b
  input "Глубина верхних дыр перфорации,м H1=";h1
  input "Глубина спуска насоса, м H2=";h2
  input "Динамический уровень, м H3=";h3
  input "Дебит скважины, м^3/сут Q=";q
  p2=(((r0+r)/2)*9.81*(h2-h3)/1000000)+p3
  r11=fnr(p1)
  r12=fnr(p2)
  r1=(r11+r12)/2
  r21=fnr(p3)
  r2=(r12+r21)/2
  r3=r1*(1-b)+r4*b
  p4=9.81*r3*(h1-h2)/1000000
  p5=9.81*r2*(h2-h3)/1000000
  p0=p3+p4+p5
  k1=q/(p1-p0)
  print: print
  print "Результаты расчетов:"
  print "Давление на приеме насоса, МПа =>                           ";using "##.##";p2
  print "Забойное давление, МПа =>                                   ";using "##.##";p0
  print "Коэффициент продуктивности, м^3/(сут*МПа) =>                ";using "##.##";k1
  print "Плотность водонефтяной эмульсии,кг/м^3 =>                   ";using "####.#";r3
  print "плотность нефти на участке забой-насос,кг/м^3 =>            ";using "####.#";r1
  print "плотность нефти на участке забой-динамический уровень,кг/м^3";using "####.#";r2
  print "гидростатическое давление столба водонефтяной эмульсии,МПа  ";using "##.##";p4
  stop
  end

