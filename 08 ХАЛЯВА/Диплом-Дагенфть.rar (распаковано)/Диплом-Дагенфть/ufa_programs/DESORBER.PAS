program V1; {  РАСЧЕТ ДЕСОРБЕРА ДЛЯ РЕГЕНЕРАЦИИ РАСТВОРА ДЭГ   }
const t2=105;t1=154;mgln=106.12;k1=3.85;pa=0.120;x1=0.987;
var x2,ggln,ngl,f,s,ng1,sum,gpgc,gg1,tg,sum4,pg,sum8,sum9,vg1,pgln,w,g1,gn1,g2,gn:real;
      d2,gg,pn3,g05,qg2g,qgngc,q1gg,qgg,ht5,ht4,sum11, sum1,sum2,sum3:real;
      j1,j2,sum13,cg,r,c2,r1,cg1,c1,h14,u,hd3,hd2,cdg1,h12,n9:real;
      hr,sum5,qg1g,qggln,ht3,ht2,cdg,hd,sum6,sum7,hd1,sum10:real;
    ttt,i:integer;
    g0,k,g,k0,m,n,g01,d,y03,x03,y7,y6,g4,g3,z01,y02,x02,z0,x0,y0:array[1..6] of real;
    f5,g5,h5,n5:array[2..6] of real;
    cp,cp1:array[1..6] of real;
    x01,y9,y01,y,c,a,y8,gg5,b:array[1..6] of real;
f1:text;
label 1,2,3;
begin
      for i:=1 to 25 do writeln('');
      writeln('            РАСЧЕТ ДЕСОРБЕРА ДЛЯ РЕГЕНЕРАЦИИ РАСТВОРА ДЭГ');
      writeln('          Программу составил ст. гр. ГГ-88-01 Валеев Р.М.');
      writeln('          Руководители доц. Васильев В.И.,доц.Чеботарев В.В.');
      writeln('                    Уфимский нефтяной институт');
      writeln('             Кафедра разработки и эксплуатации ГиГКМ');
      writeln('                            1992 год');
1:    writeln('');
      writeln('ВВЕДИТЕ СЛЕДУЮЩИЕ ИСХОДНЫЕ ДАННЫЕ:');
      write('  Конц-ция ДЭГа на входе,масс. доли:........ ');read(x2);
      write('  Количество раствора ДЭГа,кг/час:.......... ');read(ggln);
      ngl:=ggln*x2/mgln;
      f:=1-(x2*(1-x1)/(x1*(1-x2)));
      s:=(f-0.28)/0.467;
      ng1:=ngl*s/k1;
      a[3]:=16;a[4]:=30;a[5]:=44;a[6]:=58;a[1]:=0;a[2]:=0;
      b[1]:=0;b[2]:=0;
      writeln('  Содержание компонентов отдув. газа,мольн.доли:');
      write('метан .. ');read(b[3]);
      write('этан ... ');read(b[4]);
      write('пропан . ');read(b[5]);
      write('бутан .. ');read(b[6]);
      sum:=0;
      for i:=1 to 6 do
                begin
                   c[i]:=a[i]*b[i];
                   sum:=sum+c[i];
                end;
      for i:=1 to 6 do
                y[i]:=c[i]/sum;
      gg1:=ng1*sum;
      pg:=sum*pa*273/(22.4*(154+273)*0.1);
      vg1:=gg1/pg;
           writeln('  Состав насыщенного раствора ДЭГ, поступающего');
           writeln('  на регенерацию, мольн. доли: ');
           write('ДЭГ .......');read(d[1]);
           write('вода ..... ');read(d[2]);
           write('метан .... ');read(d[3]);
           write('этан ..... ');read(d[4]);
           write('пропан ... ');read(d[5]);
           write('бутан .... ');read(d[6]);
       w:=vg1*1055/ggln;
       k[1]:=0.0115;k[2]:=1.2;k[3]:=210;k[4]:=68;k[5]:=30;k[6]:=15;
       m[1]:=106.12;m[2]:=18;m[3]:=16;m[4]:=30;m[5]:=44;m[6]:=58;
       sum1:=0;sum2:=0;
             for i:=1 to 6 do
              begin
                 x0[i]:=d[i]/(1+0.106*(k[i]-1));
                 y0[i]:=k[i]*x0[i];
                 g0[i]:=m[i]*x0[i];sum1:=sum1+g0[i]
              end;
       for i:=1 to 6 do
          begin
            z0[i]:=m[i]*y0[i];sum2:=sum2+z0[i];
          end;
       for i:=1 to 6 do
          begin
                x01[i]:=g0[i]/sum1;
                y01[i]:=z0[i]/sum2;
          end;
       k0[1]:=0.0648;k0[2]:=3.85;k0[3]:=230;k0[4]:=82;k0[5]:=41;k0[6]:=22;
       sum3:=0;
              for i:=1 to 6 do
                begin
                 x03[i]:=x0[i]/(1+0.0032*(k0[i]-1));
                 y03[i]:=k0[i]*x03[i];
                 g01[i]:=m[i]*x03[i];sum3:=sum3+g01[i];
                end;
              sum4:=0;
              for i:=1 to 6 do
               begin
                z01[i]:=m[i]*y03[i];sum4:=sum4+z01[i];
               end;
           for i:=1 to 6 do
             begin
              x02[i]:=g01[i]/sum3;
              y02[i]:=z01[i]/sum4;
             end;
          j1:=(sum2/92.7)*0.106;
          j2:=0.0032*(sum4/sum1);
          gn:=j1*ggln;
          g1:=ggln-gn;
          gn1:=j2*g1;
          g2:=g1-gn1;
          gpgc:=gn+gn1+gg1;
           sum5:=0;
           for i:=1 to 6 do
           begin
              g3[i]:=gn*y01[i];sum5:=sum5+g3[i];
           end;
           sum6:=0;
           for i:=1 to 6 do
             begin
               g4[i]:=y02[i]*gn1;sum6:=sum6+g4[i];
             end;
             sum7:=0;
             for i:=1 to 6 do
             begin
                gg5[i]:=y[i]*gg1;sum7:=sum7+gg5[i];
             end;
             for i:=1 to 6 do
               begin
                 g[i]:=y01[i]*gn+y02[i]*gn1+y[i]*gg1;
               end;
            sum9:=0;
             for i:=1 to 6 do
                begin
                   n[i]:=g[i]/m[i];sum9:=sum9+n[i];
                end;
             sum8:=0;
             for i:=1 to 6 do
             sum8:=sum8+g[i];
             for i:=1 to 6 do
             begin
                y6[i]:=g[i]/sum8;
                y7[i]:=n[i]/sum9;
             end;
         f5[2]:=0.4015;f5[3]:=0.5843;f5[4]:=0.6246;f5[5]:=0.6622;f5[6]:=0.6571;
         g5[2]:=-0.0278;g5[3]:=-0.01519;g5[4]:=-0.02562;g5[5]:=-0.03271;g5[6]:=-0.03313;
         h5[2]:=79.22e-5;h5[3]:=-2.94e-5;h5[4]:=35.94e-5;h5[5]:=62.19e-5;
         h5[6]:=64.19e-5;
         n5[2]:=2.641;n5[3]:=1.855;n5[4]:=0.334;n5[5]:=-0.078;n5[6]:=0;
         for i:=2 to 6 do
           begin
             cp[i]:=f5[i]*1.05+g5[i]*1.05*1.05+h5[i]*1.05*1.05*1.05+n5[i]*100/105;
           end;
        hd1:=2.5*105;
        r:=927.94-0.647*t2;
        hd:=hd1+r;
        cdg:=hd/105;
        cp[1]:=cdg;
        sum10:=0;
        for i:=1 to 6 do
        begin
           y8[i]:=cp[i]*y01[i];sum10:=sum10+y8[i];
        end;
        cg:=2.68;
        ht2:=sum10*105;ht3:=cg*105;
        qggln:=(ggln*(ht2*j1+ht3*(1-j1)))/3599.6;
        for i:=2 to 6 do
           begin
             cp1[i]:=f5[i]*1.54+g5[i]*1.54*1.54+h5[i]*1.54*1.54*1.54+n5[i]*100/154;
           end;
         hd2:=2.8*154;
         r1:=927.94-0.647*154;
         hd3:=hd2+r1;sum11:=0;
         cdg1:=hd3/154;
         cp1[1]:=cdg1;
           for i:=1 to 6 do
               begin
                y9[i]:=cp1[i]*y02[i];
                sum11:=sum11+y9[i];
           end;
           cg1:=2.83;
           ht4:=sum11*154;
           ht5:=cg1*154;
           qg1g:=gg1*2.62*154/3599.6;
           qgg:=(g1*(ht4*j2+ht5*(1-j2)))/3599.6;
           q1gg:=(g1*ht3)/3599.6;
           qgngc:=(302*2.56*100)/3599.6;
           qg2g:=(g2*ht5)/3599.6;
           g05:=-(3600*(q1gg+qgngc+qg2g-qggln-qg1g-qgg))/(2677-406);
        gg:=g2/3600;
        pn3:=sum13*0.12*273/(22.4*(154+273)*0.1);
        d2:=(1800*gg/1018+sqrt((0.25*550+35)*158/sqrt(0.58*(1018-0.58))))/(0.25*550+35);
      writeln('  Число тарелок в верхней секции');
      write('   (рекомендуемые значения  2..4):.......... n=');read(n9);
        h12:=(n9-1)*0.6;
      write('  К.П.Д. тарелок:........................... ');read(u);
        h14:=(3/u-1)*0.6;
        hr:=h12+h14+1+1.2+2.5;
      for i:=1 to 25 do writeln('');
      WRITELN('Для вывода результатов расчетов на экран наберите число "1",');
      WRITELN('на принтер - число "2" и нажмите клавишу "Enter" ');
      readln(ttt);
      if ttt=2 then begin assign(f1,'prn');rewrite(f1);end
               else begin assign(f1,'');rewrite(f1);end;
      for i:=1 to 25 do writeln('');
      if ttt<>2 then goto 3;
      writeln(f1,'            РАСЧЕТ ДЕСОРБЕРА ДЛЯ РЕГЕНЕРАЦИИ РАСТВОРА ДЭГ');
      writeln(f1,'');
      writeln(f1,'ИСХОДНЫЕ ДАННЫЕ:');
      writeln(f1,'  Конц-ция ДЭГа на входе,масс. доли:........ ',x2:5:4);
      writeln(f1,'  Количество раствора ДЭГа,кг/час:.......... ',ggln:5:2);
      writeln(f1,'  Содержание компонентов отдув. газа,мольн.доли:');
      writeln(f1,'метан .. ',b[3]:5:5);
      writeln(f1,'этан ... ',b[4]:5:5);
      writeln(f1,'пропан . ',b[5]:5:5);
      writeln(f1,'бутан .. ',b[6]:5:5);
           writeln(f1,'  Состав насыщенного раствора ДЭГ, поступающего');
           writeln(f1,'  на регенерацию, мольн. доли: ');
           writeln(f1,'ДЭГ .......',d[1]:5:5);
           writeln(f1,'вода ..... ',d[2]:5:5);
           writeln(f1,'метан .... ',d[3]:5:5);
           writeln(f1,'этан ..... ',d[4]:5:5);
           writeln(f1,'пропан ... ',d[5]:5:5);
           writeln(f1,'бутан .... ',d[6]:5:5);
      writeln(f1,'  Число тарелок в верхней секции,шт:........ n=',n9:4:1);
      writeln(f1,'  К.П.Д. тарелок:............................. ',u:2:3);
      for i:=1 to 25 do writeln('');
3:    writeln(f1,'********************************************************************');
      writeln(f1,'РЕЗУЛЬТАТЫ РАСЧЕТОВ:');
      writeln(f1,'     Количество ДЭГа в насыщ. растворе:.... Nгл.=',ngl:5:3,' Кмоль/ч');
      writeln(f1,'     Расчетная степень отпарки:............ f=',f:5:3);
      writeln(f1,'     Количество отдув. газа :.............. ng1=',ng1:5:3,' кмоль/ч');
      writeln(f1,'     Массовый расход отд. газа:............ gg1=',gg1:5:3,' кг/ч');
      writeln(f1,'     Объемный расход отд. газа:............ vg1=',vg1:5:3,' мкуб/ч');
      writeln(f1,'     Плотность отд. газа:.................. pg=',pg:5:3,' кг/мкуб');
      writeln(f1,'     Удельный расход отд. газа:............ w=',w:5:3,' мкуб/мкуб');
      writeln(f1,'     Количество оросительной воды:.......... g05=',g05:5:3,' кг/ч');
      writeln(f1,'     Концентрация ДЭГа после первой ступени');
      writeln(f1,'     отгона,массовая доля:.................. x01[1]=',x01[1]:5:5);
      writeln(f1,'     Концентрация ДЭГа после второй ступени');
      writeln(f1,'     отгона,масс. доли:..................... x02[1]=',x02[1]:5:5);
      if ttt=2 then goto 2;
      writeln;
      WRITELN('Для продолжения расчетов нажмите клавишу "Enter" ');
      readln;
      for i:=1 to 25 do writeln('');
2:    writeln(f1);;
      writeln(f1,'После первого однократного испарения:');
      writeln(f1,'     Количество парогазовой смеси:.......... gn=',gn:5:4,' кг/ч');
      writeln(f1,'     Количество жидкости:................... g1=',g1:5:4,' кг/ч');
      writeln(f1);
      writeln(f1,'После второго однократного испарения:');
      writeln(f1,'     Количество парогазовой смеси:.......... gn1=',gn1:5:4,' кг/ч');
      writeln(f1,'     Количество жидкости:................... g2=',g2:5:4,' кг/ч');
      writeln(f1,'     Расчетный диаметр десорбера:........... d2=',d2:5:3,' м');
      writeln(f1,'     Высота верхней секции колонны:......... h12=',h12:5:3,' м');
      writeln(f1,'     Высота нижней  секции колонны:......... h14=',h14:5:3,' м');
      writeln(f1,'     Рабочая высота колонны:................ hr=',hr:5:3,' м');
      writeln(f1);;
      writeln;
      WRITELN('Для продолжения расчетов нажмите клавишу "Enter" ');
      readln;
      writeln(f1,'Материальный баланс десорбера:');
      writeln(f1,'  Поток, поступающий в десорбер:');
      writeln(f1,'     Насыщенный раствор..................... ggln=',ggln:5:4,' кг/ч');
      writeln(f1,'     Жидкость из испарителя................. g1=',g1:5:4,' кг/ч');
      writeln(f1,'     Отдувочный газ......................... gg1=',gg1:5:3,' кг/ч');
      writeln(f1,'  Поток, выводимый из десорбера:');
      writeln(f1,'     Парогазовая смесь...................... gpgc=',gpgc:5:3,' кг/ч');
      writeln(f1,'     Жидкость в испаритель.................. g1=',g1:5:4,' кг/ч');
      writeln(f1,'     Регенерированный раствор............... g2=',g2:5:3,' кг/ч');
      writeln(f1);;
      writeln;
      WRITELN('Для продолжения расчетов нажмите клавишу "Enter" ');
      readln;
      writeln(f1,'Тепловой баланс десорбера:');
      writeln(f1,'  Приход тепла в десорбер:');
      writeln(f1,'     Насыщенный раствор..................... qggln=',qggln:5:4,' кВт');
      writeln(f1,'     Жидкость из испарителя................. qgg=',qgg:5:4,' кВт');
      writeln(f1,'     Отдувочный газ......................... qg1g=',qg1g:5:3,' кВт');
      writeln(f1,'  Расход тепла из десорбера:');
      writeln(f1,'     Парогазовая смесь...................... qgngc=',qgngc:5:3,' кВт');
      writeln(f1,'     Жидкость в испаритель.................. q1gg=',q1gg:5:4,' кВт');
      writeln(f1,'     Регенерированный раствор............... qg2g=',qg2g:5:3,' кВт');
      hr:=0;
  WRITELN(f1,'');
  WRITELN('*    Расчеты окончены. Если Вы хотите провести расчеты по другому варианту ');
  WRITELN('исходных данных, то наберите число "1" и нажмите клавишу "Enter" ');
  WRITELN('*    Для выхода из программы наберите число "0" и нажмите клавишу "Enter" ');
  READLN(hr);
  if hr=1 then goto 1;
  close(f1);
end.
