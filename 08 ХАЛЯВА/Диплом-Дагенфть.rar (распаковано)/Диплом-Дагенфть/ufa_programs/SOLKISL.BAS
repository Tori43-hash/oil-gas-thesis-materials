     REM  Расчет параметров солянокислотной обработки
     input"ВВЕДИТЕ НОМЕР СКВАЖИНЫ N="N
     PRINT " Выберите требуемую концентрацию кислоты в пределах 8-10%"
     INPUT" C="C
     PRINT"  Выберите требуемое количество кислоты на 1м толщины пласта"
     PRINT"  в пределах 0.4-0.6 куб.м" :  INPUT" V1="V1
     PRINT" Введите толщину пласта ,м":  INPUT" H="H
     PRINT" Введите требуемую концентрацию уксусной кислоты"
     PRINT" в пределах 1-2%":     INPUT" C1="C1
     PRINT" Введите требуемую концентрацию пдавиковой кислоты"
     PRINT" в пределах 1-2%" :     INPUT" C2="C2
     PRINT" Введите товарные концентрации"
     PRINT" соляной, уксусной, плавиковой кислот, %"
     INPUT" CT,CT1,CT2="CT,CT1,CT2
     PRINT" Введите глубину зумпфа, м":     INPUT" H1="H1
     PRINT" Введите диаметр обс. колонны, мм":     INPUT" D="D
     PRINT" Введите внутренний диаметр НКТ, мм":     INPUT" D1="D1
     PRINT" Введите глубину скважины, м":     INPUT" HS="HS
     PRINT
     V=V1*H :  M=1425*C*V/100 : M1=2300*C1*V/100 : M2=1920*C2*V/100
     M3=1000*(100-C-C1-C2)*V/100 : V2=3.14*D*D*1E-6/4*H1
     V3=3.14*D1*D1*1E-6/4*HS
     PRINT" НОМЕР СКВАЖИНЫ N="N
     PRINT" Требуемые количества компонентов для приготовления"
     PRINT" кислотного раствора:
     PRINT" соляная : M=";USING" #####.### ";M;:PRINT" (кг)"
     PRINT" уксусная: M=";USING" #####.### ";M1;:PRINT" (кг)"
     PRINT" плавиковая:M=";USING" #####.### ";M2;:PRINT" (кг)"
     PRINT" вода:M=";USING" #####.### ";M3;:PRINT" (кг)"
     PRINT
     PRINT" Кол-во жидкости для заполнения зумпфа VZ=";USING" #####.### ";V2;
     PRINT" куб.м"
     PRINT" Кол-во ж-сти для продавки р-ра из НКТ VP=";USING" #####.### ";V3;
     PRINT" куб.м"
     END
