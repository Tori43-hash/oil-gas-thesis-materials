{\rtf1\ansi {\colortbl;\red0\green0\blue0;\red0\green0\blue255;\red0\green255\blue255;\red0\green255\blue0;\red255\green0\blue255;\red255\green0\blue0;\red255\green255\blue0;\red255\green255\blue255;\red0\green127\blue0;}{\fonttbl{\f0\froman\cpg0\fcharset0 Times New Roman;}{\f1\froman\cpg1252\fcharset0 Times New Roman;}{\f2\froman\cpg1251\fcharset204 Times New Roman;}{\f3\froman\cpg1250\fcharset238 Times New Roman;}{\f4\froman\cpg1257\fcharset186 Times New Roman;}{\f5\froman\cpg1254\fcharset162 Times New Roman;}{\f6\froman\cpg1253\fcharset161 Times New Roman;}{\f7\froman\cpg0\fcharset1 Times New Roman;}{\f8\froman\cpg0\fcharset1 Times New Roman;}}{\stylesheet{\sbasedon222\qj\li0\ri0\fi680\sl480\slmult1\sb420\sa0 \f2\lang1049\fs24 Normal;}}\paperw11900\paperh16820\margl1080\margr1100\margt1440\margb720 \sectd \sbknone\pgwsxn11900\pghsxn16820\marglsxn1080\margrsxn1100\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \ql\li640\ri2200\fi0\sb0\sa0\sl420\slmult1 \f2\lang1049\fs24 {\b 1}{\b  \'d0\'e0\'f1\'f7\'e5\'f2 \'f2\'e5\'f5\'ed\'ee\'eb\'ee\'e3\'e8\'f7\'e5\'f1\'ea\'e8\'f5 \'ef\'ee\'ea\'e0\'e7\'e0\'f2\'e5\'eb\'e5\'e9 \'f0\'e0\'e7\'f0\'e0\'e1\'ee\'f2\'ea\'e8 \'ea\'f0\'f3\'e3\'ee\'e2\'ee\'e9 \'e7\'e0\'eb\'e5\'e6\'e8}\par\pard \plain \ql\li680\ri0\fi0\sb600\sa0\sl240\slmult1 \f2\lang1049\fs24 {\b 1.1}{\b  \'c8\'f1\'f5\'ee\'e4\'ed\'fb\'e5 \'e4\'e0\'ed\'ed\'fb\'e5}\par\pard \plain \qj\li0\ri0\fi680\sb420\sa0\sl420\slmult1 \f2\lang1049\fs24 \'cf\'ee \'e4\'e0\'ed\'ed\'fb\'ec \'e3\'e5\'ee\'eb\'ee\'e3\'ee\'f0\'e0\'e7\'e2\'e5\'e4\'ee\'f7\'ed\'fb\'f5 \'f0\'e0\'e1\'ee\'f2 \'f3\'f1\'f2\'e0\'ed\'ee\'e2\'eb\'e5\'ed\'ee, \'f7\'f2\'ee \'e7\'e0\'eb\'e5\'e6\'fc \'e8\'ec\'e5\'e5\'f2 \'ee\'e2\'e0\'eb\'fc\'ed\'f3\'fe \'f4\'ee\'f0\'ec\'f3, \'e1\'eb\'e8\'e7\'ea\'f3\'fe \'ea \'ea\'f0\'f3\'e3\'ee\'e2\'ee\'e9. \'d1\'f7\'e8\'f2\'e0\'e5\'f2\'f1\'ff, \'f7\'f2\'ee \'ed\'e0 \'e7\'e0\'eb\'e5\'e6\'e8 \'f6\'e5\'eb\'e5\'f1\'ee\'ee\'e1\'f0\'e0\'e7\'ed\'ee \'f0\'e0\'e7\'ec\'e5\'f1\'f2\'e8\'f2\'fc{ 3} \'f